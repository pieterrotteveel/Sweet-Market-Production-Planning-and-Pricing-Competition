   "cell_type": "markdown",
   "id": "9cf7754e",
   "metadata": {},
   "source": [
    "# Objective function (maximize profit)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "edb1889f",
   "metadata": {},
   "source": [
    "Profit = Revenue - IngredientCost - LaborCost - UtilitiesCost - TransportCost - PackagingCost\n",
    "\n",
    "price: dict (cake_id, channel) -> price value\n",
    "sales_vars: dict (cake_id, channel) -> pulp variable s_ij\n",
    "ingredient_inv_vars: dict ingredient -> purchased quantity (inv_k)\n",
    "prep_hours_var, pack_hours_var, oven_hours_var: capacity hour decision varstransport_cost: dict channel -> cost per unit\n",
    "packaging_cost_per_unit: dict cake_id -> packaging cost per unit produced\n",
    "cakes, channels: dataframes with structural info\n",
    "ingredient_cost: dict ingredient -> unit cost\n",
    "oven_rental, oven_cost: per hour costs\n",
    "*_wage: wage rates per hour"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fc4c296b",
   "metadata": {},
   "outputs": [],
   "source": [
    "def objective_function(model, price, sales_vars, ingredient_inv_vars, prep_hours_var, pack_hours_var, oven_hours_var, transport_cost, packaging_cost_per_unit, cakes, channels, ingredient_cost, oven_rental, oven_cost, prep_wage, pack_wage, oven_wage):\n",
    "   \n",
    "    revenue = pulp.lpSum(price[(i,j)] * sales_vars[(i,j)] for (i,j) in sales_vars)\n",
    "    ingredient_cost_total = pulp.lpSum(ingredient_cost[k] * ingredient_inv_vars[k] for k in ingredient_inv_vars)\n",
    "    labor_cost = prep_hours_var * prep_wage + pack_hours_var * pack_wage + oven_hours_var * oven_wage\n",
    "    utilities_cost = oven_hours_var * (oven_rental + oven_cost)\n",
    "    transport_cost_total = pulp.lpSum(transport_cost[j] * sales_vars[(i,j)] for (i,j) in sales_vars)\n",
    "    packaging_cost_total = pulp.lpSum(packaging_cost_per_unit[i] * sales_vars[(i,j)] for (i,j) in sales_vars)  # assume packaging consumed per unit sold\n",
    "    model += revenue - ingredient_cost_total - labor_cost - utilities_cost - transport_cost_total - packaging_cost_total, 'Total_Profit'\n",
    "    return model"
   ]
  }
